#!/usr/bin/env python
"""
SageMaker inference entrypoint (launcher).

SageMaker starts the inference container with ``docker run <image> serve``.
This launcher:

  1. Runs one-time setup (installs code/requirements.txt if present).
  2. Determines the worker count — ONE WORKER PER PROCESSOR by default, the
     same default the sagemaker-inference toolkit / Multi Model Server used —
     so the endpoint saturates all vCPUs of the hosting instance.
  3. Starts uvicorn with that many worker processes, all sharing the listening
     socket on port 8080 (or $SAGEMAKER_BIND_TO_PORT).

Worker count resolution order:
  1. $SAGEMAKER_MODEL_SERVER_WORKERS  — standard SageMaker env var, settable
     per-endpoint via the Model's `env` without rebuilding the image.
  2. os.sched_getaffinity(0)          — CPUs actually available to this
     process (respects container cpuset limits).
  3. os.cpu_count()                   — fallback.

The FastAPI app itself lives in serving_app.py (installed to /opt/serving, on
PYTHONPATH). uvicorn requires an import string ("serving_app:build_app") to
run multiple workers — passing an app object caps it at a single process,
which would leave all but one vCPU idle.

Each worker process calls build_app() and loads its own copy of the model,
matching MMS per-worker semantics.
"""
import logging
import os

import uvicorn

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")
logger = logging.getLogger("serve")

PORT = int(os.environ.get("SAGEMAKER_BIND_TO_PORT", "8080"))


def _worker_count() -> int:
    """One worker per processor, unless explicitly overridden."""
    env_workers = os.environ.get("SAGEMAKER_MODEL_SERVER_WORKERS")
    if env_workers:
        count = int(env_workers)
        logger.info("Worker count from SAGEMAKER_MODEL_SERVER_WORKERS: %d", count)
        return max(1, count)
    try:
        # CPUs available to this process — respects container CPU limits.
        count = len(os.sched_getaffinity(0))
    except AttributeError:  # non-Linux (local dev only)
        count = os.cpu_count() or 1
    logger.info("Worker count from available processors: %d", count)
    return max(1, count)


if __name__ == "__main__":
    # One-time setup before forking workers: pip install of the user's
    # code/requirements.txt must not run concurrently in every worker.
    from serving_app import prepare

    prepare()

    workers = _worker_count()
    logger.info("Starting uvicorn on port %d with %d worker(s)", PORT, workers)
    uvicorn.run(
        "serving_app:build_app",
        factory=True,
        host="0.0.0.0",
        port=PORT,
        workers=workers,
        log_level="info",
    )
