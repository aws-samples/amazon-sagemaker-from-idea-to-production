{
  "_comment": "Data-scientist guardrail: the DenyProductionPromotion statement is the gate, using the sagemaker:ModelLifeCycle/stage condition key. Reference copy for reading alongside the notebooks; the policy in force is the one attached to the pre-provisioned data-scientist role.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelRegistry",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeModelPackage",
        "sagemaker:DescribeModelPackageGroup",
        "sagemaker:ListModelPackages",
        "sagemaker:ListModelPackageGroups",
        "sagemaker:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UpdateAndTagOwnModelPackages",
      "Effect": "Allow",
      "Action": [
        "sagemaker:UpdateModelPackage",
        "sagemaker:AddTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:model-package/${MODEL_PACKAGE_GROUP_PREFIX}*",
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:model-package-group/${MODEL_PACKAGE_GROUP_PREFIX}*"
      ]
    },
    {
      "Sid": "DenyProductionPromotion",
      "Effect": "Deny",
      "Action": "sagemaker:UpdateModelPackage",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sagemaker:ModelLifeCycle/stage": "production"
        }
      }
    },
    {
      "Sid": "DenyDeploymentApproval",
      "Effect": "Deny",
      "Action": "sagemaker:UpdateModelPackage",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sagemaker:ModelApprovalStatus": "Approved"
        }
      }
    },
    {
      "Sid": "DenyUpdatesToFrozenModels",
      "Effect": "Deny",
      "Action": "sagemaker:UpdateModelPackage",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/frozen": "true"
        }
      }
    }
  ]
}
