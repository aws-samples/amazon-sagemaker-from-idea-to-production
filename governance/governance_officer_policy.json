{
  "_comment": "Reference copy of the governance-officer persona policy, for reading alongside the notebooks. The policy actually in force is the one attached to the pre-provisioned governance-officer role in your workshop account.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelRegistry",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeModelPackage",
        "sagemaker:DescribeModelPackageGroup",
        "sagemaker:ListModelPackages",
        "sagemaker:ListModelPackageGroups",
        "sagemaker:ListTags",
        "sagemaker:Search"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PromoteApproveAndLockModelPackages",
      "Effect": "Allow",
      "Action": [
        "sagemaker:UpdateModelPackage",
        "sagemaker:AddTags",
        "sagemaker:DeleteTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:model-package/${MODEL_PACKAGE_GROUP_PREFIX}*",
        "arn:aws:sagemaker:${REGION}:${ACCOUNT_ID}:model-package-group/${MODEL_PACKAGE_GROUP_PREFIX}*"
      ]
    }
  ]
}
